{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "https://flux.dev/schemas/fluxplot-recipe-0.1.0.json",
  "title": "FluxPlot recipe",
  "type": "object",
  "required": ["spec", "schemaVersion", "plot", "outputs", "inputs"],
  "properties": {
    "spec": { "const": "fluxplot/recipe" },
    "schemaVersion": { "type": "string" },
    "plot": { "type": "string" },
    "outputs": {
      "type": "object",
      "properties": {
        "svg": { "type": "string" },
        "manifest": { "type": "string" }
      }
    },
    "generatedAt": { "type": ["string", "null"] },
    "script": { "type": ["object", "null"] },
    "params": { "type": "object" },
    "command": { "type": "string" },
    "args": { "type": "array", "items": { "type": "string" } },
    "cwd": { "type": "string" },
    "output": { "type": "string" },
    "provenance": {
      "type": "object",
      "required": ["scriptDiscovery"],
      "properties": {
        "scriptDiscovery": { "enum": ["automatic", "explicit", "unavailable", "suppressed"] },
        "scriptSha256": { "type": "string" },
        "python": { "type": "string" },
        "platform": { "type": "string" },
        "packages": { "type": "object", "additionalProperties": { "type": "string" } },
        "git": {
          "type": "object",
          "required": ["commit"],
          "properties": {
            "commit": { "type": "string" },
            "dirty": { "type": "boolean" }
          }
        }
      }
    },
    "inputs": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["path"],
        "properties": {
          "role": { "type": "string" },
          "path": { "type": ["string", "null"] },
          "sha256": { "type": ["string", "null"] },
          "bytes": { "type": "integer" }
        }
      }
    },
    "env": { "type": ["object", "null"] }
  }
}
