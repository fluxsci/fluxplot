{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "https://flux.dev/schemas/fluxplot-manifest-0.3.1.json",
  "title": "FluxPlot manifest",
  "type": "object",
  "required": [
    "spec",
    "schemaVersion",
    "plotType",
    "svg",
    "size",
    "axes",
    "series",
    "parts",
    "build"
  ],
  "properties": {
    "spec": {
      "const": "fluxplot/manifest"
    },
    "schemaVersion": {
      "type": "string"
    },
    "generator": {
      "type": "object",
      "properties": {
        "name": {
          "type": "string"
        },
        "version": {
          "type": "string"
        },
        "matplotlib": {
          "type": "string"
        }
      }
    },
    "plotType": {
      "type": "string"
    },
    "svg": {
      "type": "string"
    },
    "artifact": {
      "type": "object",
      "properties": {
        "svgSha256": {
          "type": "string",
          "pattern": "^[0-9a-f]{64}$"
        }
      }
    },
    "size": {
      "type": "object",
      "required": [
        "width",
        "height",
        "unit"
      ],
      "properties": {
        "width": {
          "type": "number",
          "exclusiveMinimum": 0
        },
        "height": {
          "type": "number",
          "exclusiveMinimum": 0
        },
        "unit": {
          "type": "string"
        }
      }
    },
    "axes": {
      "type": "array",
      "items": {
        "type": "object",
        "required": [
          "x",
          "y"
        ],
        "properties": {
          "id": {
            "type": "string"
          },
          "svgId": {
            "type": "string"
          },
          "x": {
            "$ref": "#/$defs/axis"
          },
          "y": {
            "$ref": "#/$defs/axis"
          },
          "pixelBox": {
            "type": "object"
          },
          "panelId": {
            "type": "string"
          },
          "projection": {
            "type": "string"
          }
        }
      }
    },
    "series": {
      "type": "array",
      "items": {
        "type": "object",
        "required": [
          "id",
          "svg"
        ],
        "properties": {
          "id": {
            "type": "string"
          },
          "name": {
            "type": "string"
          },
          "kind": {
            "type": [
              "string",
              "null"
            ]
          },
          "roles": {
            "type": "array",
            "items": {
              "type": "string"
            }
          },
          "svg": {
            "type": "object"
          },
          "data": {
            "type": "object",
            "properties": {
              "x": {
                "type": "array",
                "items": {
                  "type": [
                    "number",
                    "null"
                  ]
                }
              },
              "y": {
                "type": "array",
                "items": {
                  "type": [
                    "number",
                    "null"
                  ]
                }
              }
            }
          },
          "label": {
            "type": "string"
          },
          "capture": {
            "type": "object",
            "properties": {
              "identity": {
                "type": "string"
              },
              "data": {
                "type": "string"
              }
            }
          },
          "distribution": {
            "type": "object"
          },
          "glowbar": {
            "type": "object",
            "description": "fp.glowbar payload: part=summary carries the statistics drawn for a category (n, mean, median, sd, sem, q1, q3, interval, low, high, center, x, groupColor); part=unit carries a unit's identity (units column, unit value, categories, colors)."
          },
          "fluxbox": {
            "type": "object",
            "description": "fp.fluxbox payload: part=summary carries the statistics drawn for a category (n, mean, median, sd, sem, q1, q3, iqr, whis, whiskerLow, whiskerHigh, outliers, x, groupColor); part=unit carries a unit's identity (units column, unit value, categories, colors)."
          },
          "hexmatrix": {
            "type": "object",
            "description": "fp.hexmatrix payload: the hex lattice (orientation, hexRadius, aspect, scale, gridsize/binwidth, extent), the statistic (mode points|matrix, stat or reduce, weighted, mincnt, sparse, n, dropped, hexArea, valueLabel) and every hexagon drawn (bins: row, col, x, y, count, value)."
          },
          "points": {
            "type": "array",
            "items": {
              "type": "object",
              "required": [
                "index",
                "svgId"
              ],
              "properties": {
                "index": {
                  "type": "integer"
                },
                "svgId": {
                  "type": "string"
                },
                "x": {
                  "type": "number"
                },
                "y": {
                  "type": "number"
                }
              }
            }
          },
          "panelId": {
            "type": "string"
          },
          "capabilities": {
            "type": "object",
            "required": [
              "dataMorph"
            ],
            "properties": {
              "dataMorph": {
                "type": "boolean"
              }
            }
          },
          "components": {
            "type": "array",
            "items": {
              "type": "object",
              "required": [
                "role",
                "svgId"
              ],
              "properties": {
                "role": {
                  "type": "string"
                },
                "svgId": {
                  "type": "string"
                },
                "members": {
                  "type": "array",
                  "items": {
                    "type": "string"
                  }
                },
                "memberRole": {
                  "type": "string",
                  "description": "Role of every id in members (cell, contour-level, x-hex, point)."
                }
              }
            }
          },
          "color": {
            "type": "object",
            "description": "The series' colour: scale = the colorScales[] id colouring it; hex / alpha / token / palette follow (B2).",
            "properties": {
              "scale": {
                "type": "string"
              },
              "hex": {
                "type": "string"
              },
              "alpha": {
                "type": "number"
              },
              "token": {
                "type": [
                  "string",
                  "null"
                ]
              },
              "palette": {
                "type": [
                  "object",
                  "null"
                ]
              }
            }
          }
        }
      }
    },
    "guides": {
      "type": "array"
    },
    "overlays": {
      "type": "array"
    },
    "parts": {
      "type": "object",
      "required": [
        "id",
        "role"
      ]
    },
    "build": {
      "type": "object",
      "required": [
        "order"
      ],
      "properties": {
        "order": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "presets": {
          "type": "object",
          "description": "Per-role build-animation hints, keyed by role (a consumer may override everything).",
          "additionalProperties": {
            "type": "object",
            "required": [
              "animation"
            ],
            "properties": {
              "animation": {
                "enum": [
                  "draw-on",
                  "fade-in",
                  "stagger-in",
                  "grow-from-baseline",
                  "fade-rise",
                  "write-on",
                  "pop-in"
                ]
              },
              "durationMs": {
                "type": "number",
                "minimum": 0
              },
              "delayMs": {
                "type": "number",
                "minimum": 0
              },
              "staggerMs": {
                "type": "number",
                "minimum": 0
              },
              "staggerBy": {
                "enum": [
                  "x",
                  "y",
                  "index",
                  "value",
                  "count",
                  "category"
                ]
              }
            }
          }
        }
      }
    },
    "panels": {
      "type": "array",
      "items": {
        "type": "object",
        "required": [
          "id",
          "svgId"
        ],
        "properties": {
          "id": {
            "type": "string"
          },
          "svgId": {
            "type": "string"
          },
          "label": {
            "type": "string"
          }
        }
      }
    },
    "colorScales": {
      "type": "array",
      "description": "Portable colour scales (colorscale.py): the exact lookup table and norm of every colour-mapped mark, the svg groups it colours and the colour keys drawing it. The id equals the recipe's colour-control key.",
      "items": {
        "type": "object",
        "required": [
          "id",
          "kind",
          "colormap",
          "norm",
          "mappables",
          "colorbars",
          "recolor",
          "editable"
        ],
        "properties": {
          "id": {
            "type": "string"
          },
          "kind": {
            "enum": [
              "continuous",
              "binned",
              "categorical"
            ]
          },
          "colormap": {
            "type": "object",
            "required": [
              "name",
              "source",
              "N",
              "lut",
              "under",
              "over",
              "bad",
              "discrete"
            ],
            "properties": {
              "name": {
                "type": "string"
              },
              "source": {
                "type": "string"
              },
              "N": {
                "type": "integer",
                "minimum": 1
              },
              "lut": {
                "type": "array",
                "items": {
                  "type": "string",
                  "pattern": "^#[0-9a-f]{8}$"
                },
                "minItems": 1
              },
              "under": {
                "type": "string",
                "pattern": "^#[0-9a-f]{8}$"
              },
              "over": {
                "type": "string",
                "pattern": "^#[0-9a-f]{8}$"
              },
              "bad": {
                "type": "string",
                "pattern": "^#[0-9a-f]{8}$"
              },
              "discrete": {
                "type": "boolean"
              },
              "approximate": {
                "type": "boolean"
              }
            }
          },
          "norm": {
            "type": "object",
            "required": [
              "kind",
              "vmin",
              "vmax",
              "clip",
              "extend"
            ],
            "properties": {
              "kind": {
                "enum": [
                  "linear",
                  "log",
                  "symlog",
                  "power",
                  "twoslope",
                  "centered",
                  "boundary",
                  "none",
                  "custom"
                ]
              },
              "vmin": {
                "type": [
                  "number",
                  "null"
                ]
              },
              "vmax": {
                "type": [
                  "number",
                  "null"
                ]
              },
              "clip": {
                "type": "boolean"
              },
              "extend": {
                "enum": [
                  "neither",
                  "min",
                  "max",
                  "both"
                ]
              },
              "vcenter": {
                "type": "number"
              },
              "halfrange": {
                "type": [
                  "number",
                  "null"
                ]
              },
              "gamma": {
                "type": "number"
              },
              "linthresh": {
                "type": "number"
              },
              "linscale": {
                "type": "number"
              },
              "base": {
                "type": "number"
              },
              "boundaries": {
                "type": "array",
                "items": {
                  "type": "number"
                }
              },
              "ncolors": {
                "type": "integer"
              },
              "className": {
                "type": "string"
              }
            }
          },
          "mappables": {
            "type": "array",
            "items": {
              "type": "string"
            }
          },
          "colorbars": {
            "type": "array",
            "items": {
              "type": "string"
            }
          },
          "label": {
            "type": [
              "string",
              "null"
            ]
          },
          "recolor": {
            "enum": [
              "live",
              "raster",
              "regenerate"
            ]
          },
          "valueRaster": {
            "type": "string"
          },
          "editable": {
            "type": "object",
            "required": [
              "cmap",
              "limits",
              "normKinds",
              "center"
            ],
            "properties": {
              "cmap": {
                "type": "boolean"
              },
              "limits": {
                "type": "boolean"
              },
              "normKinds": {
                "type": "array",
                "items": {
                  "type": "string"
                }
              },
              "center": {
                "type": "boolean"
              }
            }
          }
        }
      }
    }
  },
  "$defs": {
    "axis": {
      "type": "object",
      "required": [
        "scale",
        "domain",
        "anchors"
      ],
      "properties": {
        "scale": {
          "type": "string"
        },
        "label": {
          "type": "string"
        },
        "base": {
          "type": "number"
        },
        "domain": {
          "type": "array",
          "items": {
            "type": "number"
          },
          "minItems": 2,
          "maxItems": 2
        },
        "anchors": {
          "type": "array",
          "minItems": 0,
          "items": {
            "type": "object",
            "required": [
              "data",
              "svg"
            ],
            "properties": {
              "data": {
                "type": "number"
              },
              "svg": {
                "type": "number"
              }
            }
          }
        },
        "supported": {
          "type": "boolean"
        }
      },
      "allOf": [
        {
          "if": {
            "properties": {
              "supported": {
                "const": true
              }
            },
            "required": [
              "supported"
            ]
          },
          "then": {
            "properties": {
              "scale": {
                "enum": [
                  "linear",
                  "log"
                ]
              },
              "anchors": {
                "minItems": 2
              }
            }
          }
        }
      ]
    }
  }
}
